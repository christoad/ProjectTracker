DB_HOST=your-mysql-host
DB_NAME=your-database-name
DB_USER=your-username
DB_PASS=your-password

# WooCommerce REST API (Users → Profile → Application Passwords on the store)
WC_SITE_URL=
WC_USERNAME=
WC_APP_PASSWORD=
# HMAC secret WooCommerce sends with each webhook delivery (Settings → Advanced → Webhooks)
WC_WEBHOOK_SECRET=

# Shippo live API token (Shippo → Settings → API)
SHIPPO_API_TOKEN=
# Shippo webhook signing secret (from Shippo → Settings → Webhooks → Edit)
SHIPPO_WEBHOOK_SECRET=

# Ship-from address, used for Shippo shipment prep
FROM_NAME=
FROM_COMPANY=
FROM_STREET=
FROM_CITY=
FROM_STATE=
FROM_ZIP=

# Claude API key for the Parts tab "Import a Parts Order" box (console.anthropic.com > API Keys)
ANTHROPIC_API_KEY=
